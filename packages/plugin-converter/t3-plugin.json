{
  "manifestVersion": 1,
  "id": "converter",
  "name": "Converter",
  "version": "0.1.0",
  "hostApi": "1.0",
  "author": "T3 Tools",
  "description": "Format and minify JSON, and encode or decode Base64 and URL text, then insert the result into chat.",
